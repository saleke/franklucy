# Database Connection (Supabase / PostgreSQL)
# Transaction pooler (port 6543) for serverless runtime queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) for Prisma migrations and db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application Secrets
AUTH_SECRET="your-secure-random-secret-32-chars"
NEXT_PUBLIC_APP_NAME="FrankLucy"

# Optional: Supabase API Keys (if using Supabase Storage or Client SDK)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"